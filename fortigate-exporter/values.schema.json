{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "definitions": {
    "alertRule": {
      "type": "object",
      "required": ["for", "severity"],
      "properties": {
        "for": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        }
      },
      "additionalProperties": false
    },
    "toggleAlertRule": {
      "type": "object",
      "required": ["enabled", "for", "severity"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "for": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "critical"]
        }
      },
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dnsLabelOrEmpty": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "dnsSubdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  },
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "$ref": "#/definitions/dnsSubdomain"
          }
        },
        "additionalProperties": false
      }
    },
    "nameOverride": {
      "$ref": "#/definitions/dnsLabelOrEmpty"
    },
    "fullnameOverride": {
      "$ref": "#/definitions/dnsLabelOrEmpty"
    },
    "auth": {
      "type": "object",
      "required": ["existingSecret", "key", "revision"],
      "properties": {
        "existingSecret": {
          "$ref": "#/definitions/dnsSubdomain"
        },
        "key": {
          "$ref": "#/definitions/secretKey"
        },
        "revision": {
          "type": ["string", "integer"]
        }
      },
      "additionalProperties": false
    },
    "extraCA": {
      "type": "object",
      "required": ["existingConfigMap", "key", "revision"],
      "properties": {
        "existingConfigMap": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/definitions/dnsSubdomain"
            }
          ]
        },
        "key": {
          "$ref": "#/definitions/secretKey"
        },
        "revision": {
          "type": ["string", "integer"]
        }
      },
      "additionalProperties": false
    },
    "exporter": {
      "type": "object",
      "required": [
        "port",
        "scrapeTimeoutSeconds",
        "httpsTimeoutSeconds",
        "insecureSkipVerify",
        "maxBgpPaths",
        "maxVpnUsers"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "scrapeTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "httpsTimeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "insecureSkipVerify": {
          "type": "boolean"
        },
        "maxBgpPaths": {
          "type": "integer",
          "minimum": 0
        },
        "maxVpnUsers": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "$ref": "#/definitions/dnsLabelOrEmpty"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "annotations", "labels"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "labels": {
          "$ref": "#/definitions/stringMap"
        }
      },
      "additionalProperties": false
    },
    "monitoringLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "grafanaDashboard": {
      "type": "object",
      "required": ["enabled", "labels", "annotations"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "required": ["enabled", "jobName", "interval", "scrapeTimeout"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "jobName": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "scrapeTimeout": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "required": ["enabled", "jobName", "interval", "scrapeTimeout"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "jobName": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "minLength": 1
        },
        "scrapeTimeout": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s/?#]+$"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "interval": {
            "type": "string",
            "minLength": 1
          },
          "scrapeTimeout": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "prometheusRule": {
      "type": "object",
      "required": [
        "enabled",
        "exporterDown",
        "requestFailure",
        "apiUnavailable",
        "probeFailure",
        "targetsMissing",
        "slowProbe",
        "highCPU",
        "highMemory",
        "clockSkew",
        "logDisk",
        "certificateExpiry",
        "vdomLicense",
        "ipsecTunnels",
        "wanBandwidth",
        "criticalInterfaces"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "exporterDown": {
          "$ref": "#/definitions/alertRule"
        },
        "requestFailure": {
          "$ref": "#/definitions/alertRule"
        },
        "apiUnavailable": {
          "$ref": "#/definitions/alertRule"
        },
        "probeFailure": {
          "$ref": "#/definitions/alertRule"
        },
        "targetsMissing": {
          "$ref": "#/definitions/alertRule"
        },
        "slowProbe": {
          "type": "object",
          "required": ["thresholdSeconds", "for", "severity"],
          "properties": {
            "thresholdSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "highCPU": {
          "type": "object",
          "required": ["thresholdRatio", "for", "severity"],
          "properties": {
            "thresholdRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "highMemory": {
          "type": "object",
          "required": ["thresholdRatio", "for", "severity"],
          "properties": {
            "thresholdRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "clockSkew": {
          "type": "object",
          "required": ["thresholdSeconds", "for", "severity"],
          "properties": {
            "thresholdSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "logDisk": {
          "type": "object",
          "required": ["thresholdRatio", "for", "severity"],
          "properties": {
            "thresholdRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "certificateExpiry": {
          "type": "object",
          "required": [
            "warningDays",
            "criticalDays",
            "for",
            "warningSeverity",
            "criticalSeverity"
          ],
          "properties": {
            "warningDays": {
              "type": "integer",
              "minimum": 1
            },
            "criticalDays": {
              "type": "integer",
              "minimum": 1
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "warningSeverity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            },
            "criticalSeverity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "vdomLicense": {
          "type": "object",
          "required": ["thresholdRatio", "for", "severity"],
          "properties": {
            "thresholdRatio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "ipsecTunnels": {
          "type": "object",
          "required": ["mustStayUp", "for", "severity"],
          "properties": {
            "mustStayUp": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["device", "vdom", "phase1", "phase2"],
                "properties": {
                  "device": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "vdom": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase1": {
                    "type": "string",
                    "minLength": 1
                  },
                  "phase2": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              }
            },
            "for": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warning", "critical"]
            }
          },
          "additionalProperties": false
        },
        "wanBandwidth": {
          "type": "object",
          "required": ["devices", "warning", "critical"],
          "properties": {
            "devices": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "aliasRegex",
                  "downstreamKbps",
                  "upstreamKbps"
                ],
                "properties": {
                  "aliasRegex": {
                    "type": "string",
                    "minLength": 1
                  },
                  "downstreamKbps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "upstreamKbps": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "warning": {
              "type": "object",
              "required": ["thresholdRatio", "for", "severity"],
              "properties": {
                "thresholdRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "for": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": ["info", "warning", "critical"]
                }
              },
              "additionalProperties": false
            },
            "critical": {
              "type": "object",
              "required": ["thresholdRatio", "for", "severity"],
              "properties": {
                "thresholdRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "for": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": ["info", "warning", "critical"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "criticalInterfaces": {
          "type": "object",
          "required": [
            "deviceAliasRegex",
            "deviceNameRegex",
            "nameRegex",
            "down",
            "errorRatio",
            "utilization"
          ],
          "properties": {
            "deviceAliasRegex": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "deviceNameRegex": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "nameRegex": {
              "type": "string"
            },
            "down": {
              "$ref": "#/definitions/toggleAlertRule"
            },
            "errorRatio": {
              "type": "object",
              "required": [
                "enabled",
                "thresholdRatio",
                "minimumPacketsPerSecond",
                "for",
                "severity"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "thresholdRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minimumPacketsPerSecond": {
                  "type": "number",
                  "minimum": 0
                },
                "for": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": ["info", "warning", "critical"]
                }
              },
              "additionalProperties": false
            },
            "utilization": {
              "type": "object",
              "required": [
                "enabled",
                "deviceAliasRegex",
                "thresholdRatio",
                "for",
                "severity"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "deviceAliasRegex": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "thresholdRatio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "for": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "type": "string",
                  "enum": ["info", "warning", "critical"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  },
  "required": [
    "replicaCount",
    "image",
    "imagePullSecrets",
    "nameOverride",
    "fullnameOverride",
    "auth",
    "extraCA",
    "exporter",
    "serviceAccount",
    "service",
    "grafanaDashboard",
    "monitoringLabels",
    "serviceMonitor",
    "probe",
    "targets",
    "prometheusRule",
    "podAnnotations",
    "podLabels",
    "podSecurityContext",
    "securityContext",
    "resources",
    "nodeSelector",
    "tolerations",
    "affinity"
  ],
  "additionalProperties": false
}
